<UserControl x:Class="MapleWindow.App.Views.SpeechBubbleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <FontFamily x:Key="MaplestoryFontFamily">pack://application:,,,/Fonts/#Maplestory</FontFamily>
    </UserControl.Resources>
    <Border Background="White" BorderBrush="#333333" BorderThickness="1.5" CornerRadius="10" Padding="10,6" MaxWidth="360">
        <TextBlock x:Name="BubbleTextBlock" TextWrapping="Wrap" FontSize="18" Foreground="#222222"
                   LineHeight="27" LineStackingStrategy="BlockLineHeight"
                   FontFamily="{StaticResource MaplestoryFontFamily}" FontWeight="Light" />
    </Border>
</UserControl>
