<Window x:Class="MapleWindow.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MapleWindow.App.Views"
        Title="MapleWindow"
        Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="Manual">

    <!-- Row1's fixed height keeps the character's rendered size constant whether or not the bubble
         is showing. The window itself is SizeToContent="Height", so the bubble's Auto row (Row0)
         grows the window upward from the bottom — see OnSizeChanged, which re-pins the character's
         feet to the same screen-bottom pivot every time Height changes, instead of letting the
         fixed-height character row get pushed down as Row0 grows (Grid rows always stack from the
         top; there's no such thing as a bottom-anchored row without a window resize to match).
         Row0's Visibility is Hidden (not Collapsed) between lines of the same speech cycle, so it keeps
         reserving its layout space — a window resize/reposition round-trip on every single line was
         visibly flickering the overlay. Collapsed is reserved for when the whole queue is done and the
         window can actually shrink back down. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <views:SpeechBubbleControl Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8"
                                    Text="{Binding BubbleText}"
                                    EmphasisTerms="{Binding BubbleEmphasisTerms}"
                                    Visibility="{Binding BubbleVisibility}" />

        <Image Grid.Row="1" Source="{Binding SpriteImage}" Stretch="Uniform"
               VerticalAlignment="Bottom" HorizontalAlignment="Center"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="{Binding ScaleX}" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
