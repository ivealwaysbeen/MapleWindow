<Window x:Class="MapleWindow.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Height="460" Width="440" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="대사 출력 주기(초)" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <TextBox Width="80" Margin="8,0,0,0" DockPanel.Dock="Left"
                     Text="{Binding SpeakIntervalSeconds}" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="무기 모션" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <ComboBox Width="160" Margin="8,0,0,0" DockPanel.Dock="Left"
                      ItemsSource="{Binding WeaponMotionOptions}"
                      DisplayMemberPath="Label" SelectedValuePath="Code"
                      SelectedValue="{Binding WeaponMotion}" />
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="캐릭터 크기" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <ComboBox Width="80" Margin="8,0,0,0" DockPanel.Dock="Left"
                      ItemsSource="{Binding CharacterScaleOptions}"
                      SelectedItem="{Binding CharacterScale}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat=x{0}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <ListView Grid.Row="3" ItemsSource="{Binding ItemsView}">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Background="#EEEEEE" Padding="4,3" Margin="0,4,0,0" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="콘텐츠" Width="220" DisplayMemberBinding="{Binding ContentName}" />
                    <GridViewColumn Header="알림 끄기" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Muted}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="하루 1회만" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding OnceDailyOnly}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="새로고침" Width="90" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
            <Button Content="닫기" Width="90" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
